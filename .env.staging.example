# Staging. In CI, paste this into the File variable STAGING_ENV_FILE.

# environment (development, staging, production)
APP_ENV=staging

# The hostname or IP address that clients use to reach the app
APP_HOST=localhost
FRONTEND_PORT=8083
BACKEND_PORT=8084

PAGEWISE_DATA_DIR=/srv/pagewise/staging

# Generate with: openssl rand -hex 32
# Use letters and numbers only, because it becomes part of the database URL.
POSTGRES_PASSWORD=postgres_password

ADMIN_USER=admin_username
ADMIN_PASS=admin_password

FRONTEND_IMAGE=registry.gitlab.com/hirojk/pagewise/frontend-staging:latest
BACKEND_IMAGE=registry.gitlab.com/hirojk/pagewise/backend-staging:latest
