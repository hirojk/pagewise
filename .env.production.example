# Production. In CI, paste this into the File variable PRODUCTION_ENV_FILE.

# environment (development, staging, production)
APP_ENV=production

# The hostname or IP address that clients use to reach the app
APP_HOST=localhost
FRONTEND_PORT=8085
BACKEND_PORT=8086

PAGEWISE_DATA_DIR=/srv/pagewise/production

# Generate with: openssl rand -hex 32
# Use letters and numbers only, because it becomes part of the database URL.
POSTGRES_PASSWORD=postgres_password

ADMIN_USER=admin_username
ADMIN_PASS=admin_password

FRONTEND_IMAGE=registry.gitlab.com/hirojk/pagewise/frontend-production:latest
BACKEND_IMAGE=registry.gitlab.com/hirojk/pagewise/backend-production:latest
