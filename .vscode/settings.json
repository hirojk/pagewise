{
  "files.exclude": {
    "**/.turbo": true,
    "**/node_modules": true
  },
  
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lockb, .npmrc, .nvmrc, nodemon.json",
    "tsconfig.json": "tsconfig.*.json, expo-env.d.ts",
    ".env": ".env.*",
    ".gitignore": ".gitattributes, .gitmodules",
    ".eslintrc*": ".eslintignore",
    ".prettierrc*": ".prettierignore",
    "docker-compose.yml": "docker-compose*, .dockerignore",
    "nginx.conf": "nginx.prod.conf, nginx.staging.conf",
    "README.md": "CHANGELOG.md, CONTRIBUTING.md, LICENSE, CODE_OF_CONDUCT.md"
  },

  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode"
}
