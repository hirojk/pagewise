{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "FRONTEND_URL",
        "ADMIN_USER",
        "ADMIN_PASS",
        "DATABASE_URL",
        "APP_ENV",
        "COOKIE_SECURE",
        "EXPO_PUBLIC_API_PORT",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "API_PORT",
        "FRONTEND_URL",
        "ADMIN_USER",
        "ADMIN_PASS",
        "DATABASE_URL",
        "APP_ENV",
        "COOKIE_SECURE",
        "EXPO_PUBLIC_API_PORT",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "test:unit": {
      "cache": false,
      "persistent": true,
      "env": [
        "TEST_DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "@pagewise/frontend#dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "env": [
        "API_PORT",
        "FRONTEND_URL",
        "ADMIN_USER",
        "ADMIN_PASS",
        "DATABASE_URL",
        "APP_ENV",
        "COOKIE_SECURE",
        "EXPO_PUBLIC_API_PORT",
        "EXPO_PUBLIC_API_URL"
      ],
      "passThroughEnv": [
        "EXPO_TOKEN",
        "EXPO_USERNAME",
        "EXPO_PASSWORD"
      ]
    }
  }
}
