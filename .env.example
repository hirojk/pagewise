# Local development. Copy to .env.

# environment (development, staging, production)
APP_ENV=development

# Port of the backend API; also used by the frontend in development.
API_PORT=5000

# backend
FRONTEND_URL=http://localhost:8081
ADMIN_USER=admin_username
ADMIN_PASS=admin_password
COOKIE_SECURE=false

# database (from docker-compose.yml)
DATABASE_URL=postgres://pagewise:pagewise@localhost:5432/pagewise
