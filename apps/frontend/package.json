{
  "name": "@pagewise/frontend",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm --filter @pagewise/shared build && pnpm expo:login && node scripts/expo-start.mjs",
    "dev:web": "pnpm --filter @pagewise/shared build && node scripts/expo-start.mjs --web",
    "dev:tunnel": "pnpm --filter @pagewise/shared build && pnpm expo:login && node scripts/expo-start.mjs --tunnel",
    "expo:login": "node --env-file-if-exists=.env.local scripts/ensure-expo-login.mjs",
    "build": "expo export --platform web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@pagewise/shared": "workspace:*",
    "axios": "1.21.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sortables": "^1.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0 <27.0.0"
  }
}
